{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repomark.dev/schemas/verification-report-v1/report.schema.json",
  "title": "RepoMarkVerificationReportV1",
  "description": "Schema for RepoMark verification output reports (VerificationResult).",
  "type": "object",
  "required": [
    "_type",
    "reportVersion",
    "verifiedAt",
    "target",
    "status",
    "claim",
    "cryptographicChecks",
    "offlineEvidence",
    "errors",
    "warnings",
    "summary"
  ],
  "additionalProperties": false,
  "properties": {
    "_type": {
      "type": "string",
      "const": "https://repomark.dev/verification-report/v1",
      "description": "Identifies the payload as a RepoMark verification report."
    },
    "reportVersion": {
      "type": "string",
      "const": "v1",
      "description": "Version of the verification report schema."
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp when verification was executed."
    },
    "target": {
      "type": "object",
      "required": ["type", "path", "rawDigest"],
      "additionalProperties": false,
      "description": "Target subject that was submitted for verification.",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["single-file", "file-set", "repository", "portable-capsule"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "rawDigest": {
          "type": "object",
          "required": ["algorithm", "value"],
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": ["sha256", "sha512", "repomark-merkle-v1"]
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64,128}$"
            }
          }
        },
        "textNormalizedDigest": {
          "type": "object",
          "required": ["algorithm", "value"],
          "additionalProperties": false,
          "description": "Optional diagnostic-only text-normalized digest.",
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": ["sha256-crlf-norm-v1", "sha256-ws-norm-v1"]
            },
            "value": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{64}$"
            }
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "TAMPERED",
        "UNTRUSTED_KEY",
        "INVALID_SIGNATURE",
        "REVOKED",
        "MISMATCH",
        "ERROR"
      ],
      "description": "Overall deterministic cryptographic verification outcome."
    },
    "claim": {
      "type": "object",
      "required": ["claimKind", "isDefaultKind", "issuerId"],
      "additionalProperties": false,
      "description": "Attested claim kind details.",
      "properties": {
        "claimKind": {
          "type": "string",
          "enum": ["verified-origin", "original-author", "organization-origin"]
        },
        "isDefaultKind": {
          "type": "boolean",
          "description": "True if claimKind is verified-origin."
        },
        "issuerId": {
          "type": "string",
          "minLength": 1
        },
        "organization": {
          "type": "string"
        }
      }
    },
    "cryptographicChecks": {
      "type": "object",
      "required": [
        "rawDigestMatch",
        "merkleProofValid",
        "signatureValid",
        "signatureAlgorithm",
        "keyId",
        "keyTrustStatus",
        "cleanExportVerified"
      ],
      "additionalProperties": false,
      "description": "Deterministic cryptographic validation checkpoints.",
      "properties": {
        "rawDigestMatch": {
          "type": "boolean",
          "description": "True if target raw byte digest matches the statement/capsule record."
        },
        "merkleProofValid": {
          "type": ["boolean", "null"],
          "description": "True if Merkle inclusion proof verified against root digest, null if direct."
        },
        "signatureValid": {
          "type": "boolean",
          "description": "True if digital signature over root digest/statement is mathematically valid."
        },
        "signatureAlgorithm": {
          "type": "string",
          "enum": ["ed25519", "ecdsa-p256-sha256", "rsa-pss-sha256"]
        },
        "keyId": {
          "type": "string"
        },
        "keyTrustStatus": {
          "type": "string",
          "enum": ["TRUSTED", "UNTRUSTED", "UNKNOWN", "REVOKED"]
        },
        "cleanExportVerified": {
          "type": "boolean",
          "description": "True if attestation confirms operation was performed on a clean export."
        }
      }
    },
    "watermarkAnalysis": {
      "type": "object",
      "required": ["detected", "scheme", "confidence", "persistenceRating"],
      "additionalProperties": false,
      "description": "Probabilistic and conditional watermark analysis results. Formally separate from deterministic provenance.",
      "properties": {
        "detected": {
          "type": "boolean",
          "description": "True if watermark signals were recognized."
        },
        "scheme": {
          "type": "string",
          "enum": ["repomark-ast-v1", "repomark-token-v1", "none"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "Statistical confidence score for watermark recovery [0.0 - 1.0]."
        },
        "entropy": {
          "type": "number",
          "minimum": 0.0,
          "description": "Measured entropy or dispersion of watermarking markers."
        },
        "recoveredRecipientMask": {
          "type": "string",
          "description": "Recovered recipient identifier mask if confidence threshold is met."
        },
        "persistenceRating": {
          "type": "string",
          "enum": ["INTACT", "PARTIALLY_DEGRADED", "MODIFIED", "ABSENT"],
          "description": "Categorical rating of watermark persistence after edits/formatting."
        }
      }
    },
    "offlineEvidence": {
      "type": "object",
      "required": ["networkCallsAttempted", "executionAttempted", "offlineVerified"],
      "additionalProperties": false,
      "description": "Evidence proving verification adhered to local-only, zero-execution security invariants.",
      "properties": {
        "networkCallsAttempted": {
          "type": "integer",
          "const": 0,
          "description": "Must be 0. Verifier must never make unsolicited network calls."
        },
        "executionAttempted": {
          "type": "boolean",
          "const": false,
          "description": "Must be false. Verifier must never execute repository code, build scripts, or Git hooks."
        },
        "offlineVerified": {
          "type": "boolean",
          "const": true,
          "description": "True confirming pure offline verification."
        }
      }
    },
    "errors": {
      "type": "array",
      "description": "List of fatal verification errors preventing positive verification.",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "description": "Non-fatal diagnostic warnings (e.g. text normalization divergence).",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable summary of the verification result."
    }
  }
}
